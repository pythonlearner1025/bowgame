{
  "name": "kite3d-bow-deathmatch",
  "version": "1.0.0",
  "private": true,
  "description": "Kite3D bow deathmatch with solo bots and online rooms",
  "type": "module",
  "mainScene": "assets/main.scene.gltf",
  "main": "./main.js",
  "scripts": {
    "compile:scripts": "tsc -p tsconfig.scripts.json",
    "verify:scripts": "node tools/verify-scripts.mjs",
    "verify:scene": "node tools/verify-scene.mjs",
    "verify:assets": "node tools/verify-assets.mjs",
    "test:unit": "node --test tests/bow-*.test.mjs",
    "generate:scene": "node tools/generate-scene.mjs && npm run verify:scene && npm run verify:assets",
    "export:scene": "node tools/export-scene-gltf.mjs",
    "typecheck:worker": "wrangler types && tsc -p tsconfig.worker.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "npm run lint && npm run compile:scripts && npm run verify:scripts && npm run typecheck:worker && npm run verify:assets && npm run verify:scene && npm run test:unit",
    "dev": "npm run compile:scripts && npm run verify:scripts && kite3d dev",
    "build": "npm run compile:scripts && npm run verify:scripts && npm run verify:assets && npm run verify:scene && node tools/build-kite3d-test-release.mjs",
    "preview:release": "npm run build && node tools/serve-kite3d-test-release.mjs",
    "check": "npm run compile:scripts && npm run verify:scripts && kite3d check && node tools/assert-kite3d-check.mjs && npm run verify:assets && npm run verify:scene",
    "doctor": "kite3d doctor",
    "e2e": "playwright test --config tests/e2e/playwright.config.mjs",
    "e2e:online": "npm run build && node tests/e2e/run-online.mjs",
    "probe:flicker": "npm run build && node tests/e2e/run-flicker-probe.mjs",
    "publish": "npm run compile:scripts && npm run verify:scripts && npm run verify:assets && npm run verify:scene && kite3d publish",
    "deploy:worker": "wrangler deploy"
  },
  "keywords": [
    "3d",
    "game",
    "threepipe",
    "kite3d"
  ],
  "devDependencies": {
    "@blitzdev/engine": "0.13.2",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.62.1",
    "@types/three": "https://pkg.threepipe.org/dep/@types/three/-/v0.163.10003/package.tgz",
    "esbuild": "^0.25.9",
    "es-module-lexer": "3.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.3.6",
    "globals": "16.4.0",
    "kite3d": "0.13.2",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "three": "https://pkg.threepipe.org/dep/three/-/v0.163.10003/package.tgz",
    "three-mesh-bvh": "0.9.5",
    "threepipe": "0.5.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.70.0",
    "wrangler": "4.130.0"
  },
  "kite3d": {
    "version": "0.13.2",
    "name": "Bow Deathmatch",
    "scripts": [
      "./scripts/BowGameComponent.script.js"
    ],
    "viewer": {
      "msaa": false,
      "renderScale": 1,
      "camera": {
        "type": "perspective",
        "controlsMode": "orbit",
        "position": [
          5,
          4,
          7
        ],
        "target": [
          0,
          0.8,
          0
        ]
      }
    },
    "publish": {
      "exclude": [
        "src/**",
        "tests/**",
        "tools/**",
        "evidence/**",
        "test-results/**",
        "playwright-report/**",
        "tsconfig*.json",
        "eslint.config.js",
        "*.cpuprofile",
        "vendor/**/*.d.ts",
        "vendor/**/README.md",
        "worker/**",
        "wrangler.jsonc",
        "worker-configuration.d.ts"
      ]
    }
  }
}
